<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Abundance — Find what the world is already offering you</title>
  <meta name="description" content="A personalized search engine for free, sponsored, funded, donated, and zero-cost opportunities." />
  <style>
    :root{
      --bg:#f7f7f2;
      --panel:#ffffff;
      --ink:#10110f;
      --muted:#686b63;
      --line:#e7e8e1;
      --accent:#1f5f46;
      --accent2:#e7f3ec;
      --gold:#9d7a2e;
      --warn:#8a4f19;
      --shadow: 0 10px 30px rgba(22,24,18,.06);
      --radius:22px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:var(--bg);
      color:var(--ink);
    }
    button,input,select,textarea{font:inherit}
    button{cursor:pointer}
    .shell{max-width:1200px;margin:0 auto;padding:18px 18px 90px}
    .topbar{
      display:flex;align-items:center;justify-content:space-between;
      gap:16px;margin-bottom:18px;
    }
    .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:20px}
    .logo{
      width:34px;height:34px;border-radius:11px;background:var(--accent);
      display:grid;place-items:center;color:white;font-weight:900;
    }
    .tag{font-size:12px;color:var(--muted)}
    .profile-chip{
      display:flex;align-items:center;gap:10px;background:var(--panel);
      border:1px solid var(--line);padding:8px 12px;border-radius:999px;
    }
    .avatar{width:28px;height:28px;border-radius:50%;background:var(--accent2);display:grid;place-items:center;font-size:12px;font-weight:700;color:var(--accent)}
    .grid{display:grid;grid-template-columns:220px 1fr;gap:20px}
    .sidebar{
      background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);
      padding:14px;box-shadow:var(--shadow);height:max-content;position:sticky;top:18px;
    }
    .navbtn{
      width:100%;border:0;background:transparent;text-align:left;padding:12px 14px;border-radius:14px;
      color:var(--muted);margin:2px 0;font-weight:650;
    }
    .navbtn.active{background:var(--accent2);color:var(--accent)}
    .side-note{
      margin-top:18px;padding:14px;border-radius:16px;background:#fbf8ef;color:#5c5030;font-size:13px;line-height:1.45;
    }
    .main{min-width:0}
    .hero{
      background:linear-gradient(135deg,#ffffff 0%,#eef5f1 100%);
      border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:var(--shadow);
    }
    .eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:800}
    h1{font-size:clamp(34px,5vw,60px);line-height:1.02;margin:10px 0 12px;max-width:830px}
    .sub{color:var(--muted);font-size:17px;line-height:1.55;max-width:820px}
    .value-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}
    .metric{
      background:rgba(255,255,255,.74);border:1px solid var(--line);border-radius:18px;padding:16px;
    }
    .metric .big{font-size:28px;font-weight:850}
    .metric .label{font-size:13px;color:var(--muted);margin-top:4px}
    .askbox{
      margin-top:18px;background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:12px;display:flex;gap:10px;
    }
    .askbox input{flex:1;border:0;outline:none;padding:10px;background:transparent}
    .primary{
      border:0;background:var(--accent);color:white;border-radius:14px;padding:12px 16px;font-weight:750;
    }
    .ghost{
      border:1px solid var(--line);background:white;color:var(--ink);border-radius:14px;padding:10px 13px;font-weight:650;
    }
    .section-head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin:26px 0 12px}
    .section-head h2{margin:0;font-size:24px}
    .section-head p{margin:0;color:var(--muted);font-size:14px}
    .cards{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
    .card{
      background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:18px;box-shadow:var(--shadow);
      display:flex;flex-direction:column;gap:12px;
    }
    .card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
    .badge{font-size:11px;font-weight:800;padding:6px 9px;border-radius:999px;background:var(--accent2);color:var(--accent)}
    .badge.urgent{background:#fff0e2;color:var(--warn)}
    .value{font-weight:850;color:var(--gold)}
    .card h3{margin:0;font-size:20px}
    .meta{display:flex;flex-wrap:wrap;gap:8px;font-size:12px;color:var(--muted)}
    .meta span{background:#f5f5f1;padding:6px 8px;border-radius:999px}
    .why{font-size:14px;line-height:1.5;color:#3e403b}
    .card-actions{display:flex;gap:8px;margin-top:auto}
    .progress{height:8px;background:#eceee9;border-radius:999px;overflow:hidden}
    .progress > div{height:100%;background:var(--accent)}
    .panel{
      background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:20px;box-shadow:var(--shadow);
    }
    .hidden{display:none!important}
    .filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
    .filters button{border:1px solid var(--line);background:white;border-radius:999px;padding:8px 12px}
    .filters button.active{background:var(--accent);color:white;border-color:var(--accent)}
    .app-row{
      display:grid;grid-template-columns:1.3fr .7fr .55fr .45fr;gap:10px;align-items:center;
      padding:14px 0;border-bottom:1px solid var(--line)
    }
    .app-row:last-child{border-bottom:0}
    .status{font-size:12px;font-weight:800;padding:6px 9px;border-radius:999px;display:inline-block}
    .status.saved{background:#f0f0ec;color:#595b55}
    .status.applying{background:#fff3dd;color:#7d5a18}
    .status.applied{background:#e8f3ec;color:#285c45}
    .profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .field{display:flex;flex-direction:column;gap:6px}
    .field label{font-size:12px;color:var(--muted);font-weight:700}
    .field input,.field select,.field textarea{
      border:1px solid var(--line);background:#fff;padding:11px 12px;border-radius:12px;outline:none;
    }
    .full{grid-column:1/-1}
    .modal{
      position:fixed;inset:0;background:rgba(10,12,10,.45);display:grid;place-items:center;padding:18px;z-index:20
    }
    .modal-card{
      width:min(680px,100%);max-height:88vh;overflow:auto;background:white;border-radius:24px;padding:22px;border:1px solid var(--line);
      box-shadow:0 30px 80px rgba(0,0,0,.18)
    }
    .modal-head{display:flex;justify-content:space-between;gap:15px;align-items:start}
    .close{border:0;background:#f3f3ef;width:34px;height:34px;border-radius:50%}
    .footer-note{font-size:12px;color:var(--muted);margin-top:20px;line-height:1.5}
    .empty{padding:26px;text-align:center;color:var(--muted)}
    @media (max-width:860px){
      .grid{grid-template-columns:1fr}
      .sidebar{position:static;display:flex;overflow:auto;gap:6px}
      .navbtn{width:auto;white-space:nowrap}
      .side-note{display:none}
      .cards{grid-template-columns:1fr}
      .value-row{grid-template-columns:1fr}
      .profile-grid{grid-template-columns:1fr}
      .full{grid-column:auto}
      .app-row{grid-template-columns:1fr}
      .profile-chip .tag{display:none}
    }
  </style>
</head>
<body>
<div class="shell">
  <div class="topbar">
    <div class="brand"><div class="logo">A</div><div>Abundance <div class="tag">Find what the world is already offering you.</div></div></div>
    <div class="profile-chip"><div class="avatar">YOU</div><div><b>Personal Radar</b><div class="tag">Boston, MA · Open to global</div></div></div>
  </div>

  <div class="grid">
    <aside class="sidebar">
      <button class="navbtn active" data-tab="for-you">For You</button>
      <button class="navbtn" data-tab="explore">Explore</button>
      <button class="navbtn" data-tab="want">I Want This</button>
      <button class="navbtn" data-tab="applications">Applications</button>
      <button class="navbtn" data-tab="profile">Profile</button>
      <div class="side-note"><b>Core belief</b><br/>Before you spend your own resources, ask whether someone, somewhere, has already created a pool of capital, access, generosity, or unused capacity for this.</div>
    </aside>

    <main class="main">
      <section id="for-you" class="tab">
        <div class="hero">
          <div class="eyebrow">Your opportunity universe</div>
          <h1>The world is more abundant than it looks.</h1>
          <div class="sub">Abundance finds legitimate free, sponsored, funded, donated, and zero-cost opportunities matched to your life — then helps you actually claim them.</div>
          <div class="value-row">
            <div class="metric"><div class="big" id="totalValue">$31,400</div><div class="label">Potential value matched to you</div></div>
            <div class="metric"><div class="big" id="matchCount">8</div><div class="label">High-fit opportunities</div></div>
            <div class="metric"><div class="big">3</div><div class="label">Deadlines within 14 days</div></div>
          </div>
          <div class="askbox">
            <input id="quickAsk" placeholder="Ask for anything: “I want my pilot license paid for”" />
            <button class="primary" onclick="runWantSearch(true)">Find a way</button>
          </div>
        </div>

        <div class="section-head"><div><h2>Best matches</h2><p>Ranked by value, eligibility, urgency, and effort.</p></div><button class="ghost" onclick="shuffleMatches()">Refresh matches</button></div>
        <div class="cards" id="bestCards"></div>
      </section>

      <section id="explore" class="tab hidden">
        <div class="section-head"><div><h2>Explore abundance</h2><p>Browse across categories, not just conventional aid.</p></div></div>
        <div class="filters" id="filters"></div>
        <div class="cards" id="exploreCards"></div>
      </section>

      <section id="want" class="tab hidden">
        <div class="panel">
          <div class="eyebrow">Reverse search the world</div>
          <h2>What do you want someone else to fund?</h2>
          <p class="sub">Describe the outcome. Abundance thinks in funding paths: government, philanthropy, nonprofit capacity, employer benefits, sponsorship, grants, fellowships, community programs, and corporate credits.</p>
          <div class="field full" style="margin-top:16px">
            <textarea id="wantInput" rows="5" placeholder="Example: I want to attend a high-quality wellness retreat without paying $4,000 out of pocket."></textarea>
          </div>
          <div style="display:flex;gap:8px;margin-top:12px"><button class="primary" onclick="runWantSearch(false)">Search funding paths</button><button class="ghost" onclick="fillExamples()">Inspire me</button></div>
        </div>
        <div id="wantResults" class="hidden">
          <div class="section-head"><div><h2>Possible funding paths</h2><p id="wantSummary"></p></div></div>
          <div class="cards" id="wantCards"></div>
        </div>
      </section>

      <section id="applications" class="tab hidden">
        <div class="section-head"><div><h2>Applications</h2><p>Your pipeline from discovery to claimed value.</p></div></div>
        <div class="panel" id="applicationList"></div>
      </section>

      <section id="profile" class="tab hidden">
        <div class="panel">
          <div class="eyebrow">Your matching profile</div>
          <h2>Teach the radar what matters.</h2>
          <div class="profile-grid">
            <div class="field"><label>Home location</label><input value="Boston, Massachusetts" /></div>
            <div class="field"><label>Search reach</label><select><option>U.S. + Global</option><option>U.S. only</option><option>Local only</option></select></div>
            <div class="field"><label>Career interests</label><input value="AI, strategy, CX, cybersecurity, health" /></div>
            <div class="field"><label>Education goals</label><input value="Certificates, degree funding, fellowships" /></div>
            <div class="field"><label>Travel flexibility</label><select><option>Open to travel</option><option>Domestic only</option><option>Local only</option></select></div>
            <div class="field"><label>Opportunity preference</label><select><option>Highest value first</option><option>Fastest to claim</option><option>Best fit first</option></select></div>
            <div class="field full"><label>What would change your life right now?</label><textarea rows="4">Education funding, career opportunities, wellness experiences, business resources, high-quality essentials, and unusual high-value opportunities.</textarea></div>
          </div>
          <div style="margin-top:14px"><button class="primary" onclick="toast('Profile saved. Matching updated.')">Save profile</button></div>
        </div>
        <div class="footer-note">Production note: a real version should store sensitive eligibility data minimally, encrypt it, and separate optional financial/health eligibility attributes from the public-facing profile.</div>
      </section>
    </main>
  </div>
</div>

<div id="modal" class="modal hidden">
  <div class="modal-card">
    <div class="modal-head">
      <div><div class="eyebrow" id="modalCat"></div><h2 id="modalTitle"></h2></div>
      <button class="close" onclick="closeModal()">×</button>
    </div>
    <p id="modalDesc" class="sub"></p>
    <div id="modalBody"></div>
    <div style="display:flex;gap:8px;margin-top:18px">
      <button class="primary" onclick="saveCurrent()">Save to applications</button>
      <button class="ghost" onclick="toast('In production, this opens the verified official source.')">Official source</button>
    </div>
  </div>
</div>

<script>
const opportunities = [
  {id:1,cat:"Education",title:"Fully funded community college pathway",value:12000,fit:97,effort:"Low",deadline:"Rolling",location:"Massachusetts",urgent:false,desc:"Tuition and mandatory fees covered for eligible residents, with potential additional education allowances.",why:"High fit because you are Massachusetts-based and actively exploring career credentials.",steps:["Check program eligibility","Complete FAFSA/MASFA if applicable","Choose an eligible certificate or associate program","Enroll at least at the required credit level"]},
  {id:2,cat:"Career",title:"Workforce-funded cybersecurity training",value:6500,fit:95,effort:"Medium",deadline:"Rolling",location:"Massachusetts",urgent:false,desc:"Potential workforce funding for eligible career training through public workforce systems.",why:"Matches your cybersecurity and career-transition goals.",steps:["Contact local workforce center","Request training-funding eligibility review","Ask specifically about approved cybersecurity providers","Submit required unemployment/income documentation"]},
  {id:3,cat:"Food",title:"Fresh local food incentive",value:480,fit:86,effort:"Low",deadline:"Monthly",location:"Massachusetts",urgent:false,desc:"Eligible households can receive additional purchasing power for local fruits and vegetables.",why:"Replaces recurring grocery expense with fresh food value.",steps:["Confirm program eligibility","Find participating farm vendors","Use eligible benefit card","Track monthly incentive limit"]},
  {id:4,cat:"Clothing",title:"Professional wardrobe program",value:900,fit:88,effort:"Low",deadline:"Rolling",location:"Boston",urgent:false,desc:"Professional clothing and career presentation support provided at no cost through nonprofit programs.",why:"Useful for executive interviews, events, and professional transitions.",steps:["Request or obtain referral if required","Book styling appointment","Share role/interview needs","Receive and keep selected attire"]},
  {id:5,cat:"Business",title:"Startup cloud and AI credits",value:10000,fit:93,effort:"Medium",deadline:"Rolling",location:"Global",urgent:false,desc:"Startup programs often provide substantial cloud, AI, developer tooling, and infrastructure credits.",why:"Strong fit for building Abundance and your other technology ventures.",steps:["Create a basic company/project profile","Prepare product website or deck","Apply to relevant startup programs","Track credit expiration and usage"]},
  {id:6,cat:"Travel",title:"Fully funded global fellowship",value:7500,fit:82,effort:"High",deadline:"Aug 28",location:"Global",urgent:true,desc:"Selected fellowships cover program fees and may include flights, lodging, meals, or stipends.",why:"You are open to global opportunities and have leadership, technology, and systems-thinking interests.",steps:["Review exact eligibility","Prepare CV and narrative","Draft impact statement","Submit before deadline"]},
  {id:7,cat:"Wellness",title:"Sponsored wellness retreat seat",value:2500,fit:79,effort:"Medium",deadline:"Sep 4",location:"U.S.",urgent:true,desc:"Retreat organizations and foundations sometimes reserve scholarship or sponsored seats for applicants.",why:"Aligned with wellness, consciousness, and human-performance interests.",steps:["Identify scholarship-based retreats","Write financial-need + purpose statement","Ask directly about sponsored seats","Request travel support separately if not included"]},
  {id:8,cat:"Learning",title:"Premium software & courses via public library",value:1020,fit:91,effort:"Low",deadline:"Always available",location:"Local",urgent:false,desc:"Library systems can unlock paid learning platforms, databases, books, media, and professional resources at no direct cost.",why:"Fastest low-friction way to replace recurring learning subscriptions.",steps:["Confirm library card status","Review digital resource catalog","Activate learning platforms","Cancel duplicate paid subscriptions"]}
];

const apps = [
  {title:"Workforce-funded cybersecurity training",status:"Applying",deadline:"Rolling",value:"$6,500"},
  {title:"Startup cloud and AI credits",status:"Saved",deadline:"Rolling",value:"$10,000"},
  {title:"Fully funded global fellowship",status:"Saved",deadline:"Aug 28",value:"$7,500"}
];

let currentFilter="All";
let currentOpp=null;

function money(n){return "$"+n.toLocaleString();}
function cardHTML(o){
  return `<div class="card">
    <div class="card-top"><span class="badge ${o.urgent?'urgent':''}">${o.urgent?'TIME-SENSITIVE':o.cat}</span><span class="value">${money(o.value)}</span></div>
    <h3>${o.title}</h3>
    <div class="meta"><span>${o.location}</span><span>${o.effort} effort</span><span>${o.fit}% fit</span><span>${o.deadline}</span></div>
    <div class="why">${o.why}</div>
    <div class="progress"><div style="width:${o.fit}%"></div></div>
    <div class="card-actions"><button class="primary" onclick="openOpp(${o.id})">View path</button><button class="ghost" onclick="quickSave(${o.id})">Save</button></div>
  </div>`
}
function render(){
  document.getElementById("bestCards").innerHTML = opportunities.slice(0,6).map(cardHTML).join("");
  const cats=["All",...new Set(opportunities.map(x=>x.cat))];
  document.getElementById("filters").innerHTML=cats.map(c=>`<button class="${c===currentFilter?'active':''}" onclick="setFilter('${c}')">${c}</button>`).join("");
  const list=currentFilter==="All"?opportunities:opportunities.filter(x=>x.cat===currentFilter);
  document.getElementById("exploreCards").innerHTML=list.map(cardHTML).join("");
  renderApps();
}
function renderApps(){
  document.getElementById("applicationList").innerHTML=apps.length?apps.map(a=>`
    <div class="app-row">
      <div><b>${a.title}</b><div class="tag">${a.deadline}</div></div>
      <div>${a.value}</div>
      <div><span class="status ${a.status.toLowerCase()}">${a.status}</span></div>
      <div><button class="ghost" onclick="toast('Application checklist opened.')">Open</button></div>
    </div>`).join(""):`<div class="empty">Nothing saved yet.</div>`;
}
function setFilter(c){currentFilter=c;render()}
function openOpp(id){
  currentOpp=opportunities.find(x=>x.id===id);
  document.getElementById("modalCat").textContent=currentOpp.cat;
  document.getElementById("modalTitle").textContent=currentOpp.title;
  document.getElementById("modalDesc").textContent=currentOpp.desc;
  document.getElementById("modalBody").innerHTML=`
    <div class="panel" style="box-shadow:none;margin-top:10px">
      <b>Why this matches you</b><p>${currentOpp.why}</p>
      <b>Estimated value</b><p>${money(currentOpp.value)}</p>
      <b>Suggested next steps</b>
      <ol>${currentOpp.steps.map(s=>`<li style="margin:8px 0">${s}</li>`).join("")}</ol>
    </div>`;
  document.getElementById("modal").classList.remove("hidden");
}
function closeModal(){document.getElementById("modal").classList.add("hidden")}
function quickSave(id){
  const o=opportunities.find(x=>x.id===id);
  if(!apps.some(a=>a.title===o.title)) apps.unshift({title:o.title,status:"Saved",deadline:o.deadline,value:money(o.value)});
  renderApps();toast("Saved to Applications.");
}
function saveCurrent(){if(currentOpp) quickSave(currentOpp.id);closeModal()}
function toast(msg){
  const t=document.createElement("div");t.textContent=msg;
  t.style.cssText="position:fixed;right:18px;bottom:18px;background:#10110f;color:white;padding:12px 16px;border-radius:14px;z-index:50;box-shadow:0 10px 30px rgba(0,0,0,.18)";
  document.body.appendChild(t);setTimeout(()=>t.remove(),2200);
}
function shuffleMatches(){
  opportunities.sort(()=>Math.random()-.5);render();toast("Matches refreshed.");
}
function runWantSearch(fromQuick){
  const text=(fromQuick?document.getElementById("quickAsk").value:document.getElementById("wantInput").value).trim();
  if(!text){toast("Tell Abundance what you want first.");return}
  document.querySelectorAll(".navbtn").forEach(b=>b.classList.remove("active"));
  document.querySelector('[data-tab="want"]').classList.add("active");
  document.querySelectorAll(".tab").forEach(t=>t.classList.add("hidden"));
  document.getElementById("want").classList.remove("hidden");
  document.getElementById("wantInput").value=text;
  const t=text.toLowerCase();
  let matches=opportunities.filter(o=>{
    if(t.includes("pilot")||t.includes("flight")) return ["Education","Career","Travel"].includes(o.cat);
    if(t.includes("retreat")||t.includes("wellness")) return ["Wellness","Travel"].includes(o.cat);
    if(t.includes("clothes")||t.includes("wardrobe")) return o.cat==="Clothing";
    if(t.includes("food")||t.includes("grocer")) return o.cat==="Food";
    if(t.includes("business")||t.includes("startup")||t.includes("ai")) return o.cat==="Business";
    return o.fit>85;
  });
  if(matches.length<3) matches=[...matches,...opportunities.filter(o=>!matches.includes(o)).slice(0,3-matches.length)];
  document.getElementById("wantSummary").textContent=`We found ${matches.length} plausible ways to reduce or eliminate your out-of-pocket cost for: “${text}”`;
  document.getElementById("wantCards").innerHTML=matches.map(cardHTML).join("");
  document.getElementById("wantResults").classList.remove("hidden");
}
function fillExamples(){
  const examples=[
    "I want to get my private pilot license without paying full price.",
    "I want a high-quality wellness retreat someone else will sponsor.",
    "I need professional clothes for executive interviews.",
    "I want $10,000+ in software and AI infrastructure credits for my startup."
  ];
  document.getElementById("wantInput").value=examples[Math.floor(Math.random()*examples.length)];
}
document.querySelectorAll(".navbtn").forEach(btn=>{
  btn.addEventListener("click",()=>{
    document.querySelectorAll(".navbtn").forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    document.querySelectorAll(".tab").forEach(t=>t.classList.add("hidden"));
    document.getElementById(btn.dataset.tab).classList.remove("hidden");
  })
})
render();
</script>
</body>
</html>
